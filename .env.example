# ── Copy to .env and fill in real values.  NEVER commit .env ──────────────
# .env is already git-ignored. This template is safe to commit.

SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_REGION=eu-central-1

# PUBLIC key — safe to ship in the Flutter client.
# Passed at build time with --dart-define, never hard-coded in lib/.
SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here

# Resend transactional mail. Server-side only. Sync these values to Supabase
# Edge Function secrets. Do not pass them to Flutter --dart-define.
RESEND_API_KEY=
EMAIL_FROM=New Coffee <mail@your-verified-domain.com>
EMAIL_REPLY_TO=
EMAIL_WEBHOOK_SECRET=
# Generate in Supabase Auth > Hooks > Send Email.
SEND_EMAIL_HOOK_SECRET=

# SECRET key — server-side ONLY. Must NEVER appear in Flutter or git.
# Used by: Supabase CLI, Edge Functions, your own backend.
SUPABASE_SERVICE_ROLE_KEY=

# Management API token. Dashboard-level, broader than the database key:
# it reaches EVERY project in the account, not just this one.
# Used only to set Exposed schemas, because managed PostgREST reads its
# config from the platform and no SQL statement can change it.
# Revoke in Supabase -> Preferences -> Access Tokens when development ends.
SUPABASE_ACCESS_TOKEN=

# Direct Postgres — used by Supabase CLI / psql / Node pg. Not by the app.
SUPABASE_DB_HOST=db.your-project-ref.supabase.co
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

# Optional: Google Sign-In (Web OAuth client ID used as serverClientId on Android).
# GOOGLE_SERVER_CLIENT_ID=your-google-web-client-id

# Moyasar sandbox app trial only. Keep the secret key in Supabase Edge Secrets.
# Enable only after configuring MOYASAR_SECRET_KEY and MOYASAR_MODE=sandbox there.
USE_MOYASAR=false
MOYASAR_PUBLISHABLE_KEY=pk_test_replace_with_moyasar_test_publishable_key

# Build the client with:
#   flutter run \
#     --dart-define=SUPABASE_URL=$SUPABASE_URL \
#     --dart-define=SUPABASE_PUBLISHABLE_KEY=$SUPABASE_PUBLISHABLE_KEY

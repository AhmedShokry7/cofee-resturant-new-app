<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Cleartext HTTP is allowed in debug builds only: it lets the debug app
         talk to a free Ollama server on the host machine via
         http://10.0.2.2:11434. The release manifest sets
         android:usesCleartextTraffic="false", so a store build can only talk
         to https backends. -->
    <application
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />
</manifest>
